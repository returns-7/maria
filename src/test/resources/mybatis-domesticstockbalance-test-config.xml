<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE configuration
        PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-config.dtd">

<configuration>
    <settings>
        <setting name="mapUnderscoreToCamelCase" value="true"/>
    </settings>

    <typeAliases>
        <typeAlias alias="DomesticInvestmentSearchDTO" type="com.app.maria.domain.domestic.dto.DomesticInvestmentSearchDTO"/>
        <typeAlias alias="DomesticInvestmentListDTO" type="com.app.maria.domain.domestic.dto.DomesticInvestmentListDTO"/>
        <typeAlias alias="DomesticHoldingDTO" type="com.app.maria.domain.domestic.dto.DomesticHoldingDTO"/>
        <typeAlias alias="DomesticInvestmentSummaryDTO" type="com.app.maria.domain.domestic.dto.DomesticInvestmentSummaryDTO"/>
        <typeAlias alias="DomesticProductDTO" type="com.app.maria.domain.domestic.dto.DomesticProductDTO"/>
        <typeAlias alias="DomesticRestrictedHoldingDTO" type="com.app.maria.domain.domestic.dto.DomesticRestrictedHoldingDTO"/>
        <typeAlias alias="DomesticCashHeavyAccountDTO" type="com.app.maria.domain.domestic.dto.DomesticCashHeavyAccountDTO"/>
        <typeAlias alias="DomesticFundHoldingDetailDTO" type="com.app.maria.domain.domestic.dto.DomesticFundHoldingDetailDTO"/>
        <typeAlias alias="DomesticAccountLiteDTO" type="com.app.maria.domain.domestic.dto.DomesticAccountLiteDTO"/>
    </typeAliases>

    <environments default="domesticstockbalance-mapper-test">
        <environment id="domesticstockbalance-mapper-test">
            <transactionManager type="JDBC"/>
            <dataSource type="POOLED">
                <property name="driver" value="org.h2.Driver"/>
                <property name="url" value="jdbc:h2:mem:domesticstockbalance_mapper_test;MODE=MySQL;DB_CLOSE_DELAY=-1;DATABASE_TO_LOWER=TRUE"/>
                <property name="username" value="sa"/>
                <property name="password" value=""/>
            </dataSource>
        </environment>
    </environments>

    <mappers>
        <mapper resource="mappers/domestic/DomesticStockBalanceMapper.xml"/>
    </mappers>
</configuration>
