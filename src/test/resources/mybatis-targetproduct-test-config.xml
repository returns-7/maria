<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE configuration
        PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-config.dtd">

<configuration>
    <settings>
        <setting name="mapUnderscoreToCamelCase" value="true"/>
    </settings>

    <typeAliases>
        <typeAlias alias="TargetProductJudgementDTO" type="com.app.maria.domain.targetproduct.dto.TargetProductJudgementDTO"/>
        <typeAlias alias="TargetProductJudgementFailureDTO" type="com.app.maria.domain.targetproduct.dto.TargetProductJudgementFailureDTO"/>
        <typeAlias alias="TargetProductJudgementListDTO" type="com.app.maria.domain.targetproduct.dto.TargetProductJudgementListDTO"/>
        <typeAlias alias="TargetProductSearchDTO" type="com.app.maria.domain.targetproduct.dto.TargetProductSearchDTO"/>
        <typeAlias alias="TargetProductSummaryDTO" type="com.app.maria.domain.targetproduct.dto.TargetProductSummaryDTO"/>
    </typeAliases>

    <environments default="targetproduct-mapper-test">
        <environment id="targetproduct-mapper-test">
            <transactionManager type="JDBC"/>
            <dataSource type="POOLED">
                <property name="driver" value="org.h2.Driver"/>
                <property name="url" value="jdbc:h2:mem:targetproduct_mapper_test;MODE=MySQL;DB_CLOSE_DELAY=-1;DATABASE_TO_LOWER=TRUE"/>
                <property name="username" value="sa"/>
                <property name="password" value=""/>
            </dataSource>
        </environment>
    </environments>

    <mappers>
        <mapper resource="mappers/targetproduct/TargetProductMapper.xml"/>
    </mappers>
</configuration>
